{
  "name": "cortico-world-listen",
  "version": "0.4.0",
  "type": "module",
  "description": "听觉（Listen）—— 给 Coopanion 桌宠的 cortico World 扩展：监听系统声音或某个应用的音频，自动把语音切成块（能量门限或可选的 Silero VAD），并把每块作为事件投进 cortico 事件流（附件是 WAV），由 agent 决定接下来做什么（比如交给 stt_transcribe 转写成文字）。 / A cortico World extension that captures system or per-application audio, segments speech locally (energy gate or optional Silero VAD), and pushes each chunk into the cortico event stream as a WAV attachment for the agent to use.",
  "license": "MIT",
  "author": {
    "name": "AqualCross"
  },
  "homepage": "https://github.com/AqualCross/cortico-world-listen#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AqualCross/cortico-world-listen.git"
  },
  "bugs": {
    "url": "https://github.com/AqualCross/cortico-world-listen/issues"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "listen",
    "listening",
    "voice",
    "vad",
    "voice-activity-detection",
    "speech-segmentation",
    "system-audio",
    "loopback",
    "wasapi",
    "audio-capture"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "dist",
    "describe.json",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "selfcheck": "node tools/check.mjs",
    "describe:extension": "node tools/describe.mjs",
    "drymount": "node --experimental-transform-types tools/drymount.mts",
    "smoke": "node tools/smoke.mjs",
    "prepublishOnly": "node tools/check.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "听觉",
    "tags": [
      "voice"
    ],
    "webUiClient": "dist/webui.js",
    "describe": "describe.json"
  },
  "dependencies": {
    "loopback-capture": "^3.0.2"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
